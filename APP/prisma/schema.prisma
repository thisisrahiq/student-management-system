// Prisma Schema for Student Management System — Registry Module
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

enum GradeClassification {
  DISTINCTION
  MERIT
  PASS
  FAIL
}

model Programme {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  baseFee   Decimal  @db.Decimal(10, 2)
  duration  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  modules   Module[]

  @@map("Programmes")
}

model Student {
  id           String          @id @default(cuid())
  studentId    String          @unique
  fullName     String
  email        String          @unique
  dateOfBirth  DateTime
  academicYear String
  status       EnrolmentStatus @default(ENROLLED)
  programmeId  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  fee         Fee?
  payments    Payment[]
  submissions Submission[]

  @@index([studentId])
  @@index([fullName])
  @@index([status])
  @@index([academicYear])
  @@map("Students")
}

model Fee {
  id             String   @id @default(cuid())
  studentId      String   @unique
  assignedAmount Decimal  @db.Decimal(10, 2)
  totalPaid      Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("Fees")
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  feeId           String
  amount          Decimal  @db.Decimal(10, 2)
  paymentDate     DateTime @default(now())
  referenceNumber String   @unique
  createdAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee     Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([paymentDate])
  @@map("Payments")
}

model Module {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  programmeId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  assessments Assessment[]

  @@map("Modules")
}

model Assessment {
  id        String   @id @default(cuid())
  title     String
  moduleId  String
  deadline  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([deadline])
  @@map("Assessments")
}

model Submission {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  filePath     String
  fileName     String
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result     Result?

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
  @@map("Submissions")
}

model Result {
  id             String              @id @default(cuid())
  submissionId   String              @unique
  numericGrade   Int
  classification GradeClassification
  isPublished    Boolean             @default(false)
  gradedAt       DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@map("Results")
}
